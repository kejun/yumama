  {
    "id": "103730028",
    "slug": "braised-hairtail",
    "title": "红烧带鱼",
    "category": "鱼鲜",
    "summary": "薄薄一层面粉，煎出金黄鱼皮，再小火入味。",
    "source": {
      "title": "零失误的红烧带鱼，经典家常菜，吃了就忘不掉的味道",
      "author": "糖宝MM木木",
      "url": "https://m.xiachufang.com/recipe/103730028/",
      "retrievedAt": "2026-10-06"
    },
    "cover": "assets/recipes/103730028/cover.jpg",
    "ingredients": [
      {
        "name": "带鱼",
        "amount": "两条"
      },
      {
        "name": "生抽",
        "amount": "3勺"
      },
      {
        "name": "老抽",
        "amount": "1勺"
      },
      {
        "name": "蚝油",
        "amount": "1勺"
      },
      {
        "name": "香醋",
        "amount": "1勺"
      },
      {
        "name": "料酒",
        "amount": "1勺"
      },
      {
        "name": "白糖",
        "amount": "10克"
      },
      {
        "name": "花椒八角干辣椒",
        "amount": "如图"
      },
      {
        "name": "葱姜蒜",
        "amount": "适量"
      },
      {
        "name": "面粉",
        "amount": "30克"
      }
    ],
    "steps": [
      {
        "title": "切段腌制",
        "text": "带鱼洗净切段，加葱姜蒜和料酒，至少腌 20 分钟。",
        "image": "assets/recipes/103730028/step-01.jpg",
        "sourceSteps": [
          1
        ],
        "timerSeconds": 1200
      },
      {
        "title": "两面裹粉",
        "text": "把面粉倒入盘中，让鱼段两面均匀沾粉。",
        "image": "assets/recipes/103730028/step-02.jpg",
        "sourceSteps": [
          2
        ]
      },
      {
        "title": "小火煎鱼",
        "text": "锅中加油，小火煎至两面金黄，盛出。等一面定型后再翻面。",
        "image": "assets/recipes/103730028/step-03.jpg",
        "sourceSteps": [
          3
        ]
      },
      {
        "title": "调好料汁",
        "text": "混合生抽 3 勺，老抽、香醋、料酒、蚝油各 1 勺，再加糖。",
        "image": "assets/recipes/103730028/step-04.jpg",
        "sourceSteps": [
          4
        ]
      },
      {
        "title": "炒香配料",
        "text": "少量油煸香葱姜蒜，加入八角、花椒、干辣椒及煎好的带鱼。",
        "image": "assets/recipes/103730028/step-05.jpg",
        "sourceSteps": [
          5,
          6
        ]
      },
      {
        "title": "加汁炖煮",
        "text": "倒入料汁和没过鱼的热水，盖锅，小火炖约 10 分钟，确认熟透。",
        "image": "assets/recipes/103730028/step-08.jpg",
        "sourceSteps": [
          7,
          8
        ],
        "timerSeconds": 600
      },
      {
        "title": "开盖收汁",
        "text": "转大火收浓汤汁后装盘，尽量少翻动鱼段。",
        "image": "assets/recipes/103730028/step-09.jpg",
        "sourceSteps": [
          9,
          10
        ]
      }
    ],
    "tips": [
      "白糖用料表写 10 克，原作步骤写一小勺或 3 颗冰糖；可按口味择一调整。",
      "花椒、八角和干辣椒原作只写“如图”，没有精确分量。腌鱼另需料酒，分量未注明。"
    ],
